# Copy this file to .env and fill in your keys. Never commit .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_FREE_CACHE_TTL_SECONDS=3600
DAILY_BUDGET_USD=1.0
AGENTIC_STEP_CAP=5

# Phase 3: Obsidian Local REST API plugin -- install the plugin in Obsidian,
# enable it, and copy the API key it generates here. Optional: without it,
# vault notes still get written directly to disk, just without the
# live-app-aware read/merge behavior.
OBSIDIAN_API_KEY=
